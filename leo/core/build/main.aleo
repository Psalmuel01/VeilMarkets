    cast r70 r72 r74 r76 r78 r80 r82 r84 r85 r19.lp_count r19.locked r64 r19.lp_collateral r86 r87 r19.lp_supply r88 into r89 as PoolState;
    set r89 into pools[r0];
    get.or_use protocol_u64[5u8] 8000u64 into r90;
    lte r90 10000u64 into r91;
    assert.eq r91 true;
    assert.eq true true;
    cast r52.fee into r92 as u128;
    cast r90 into r93 as u128;
    cast 10000u64 into r94 as u128;
    mul r92 r93 into r95;
    div r95 r94 into r96;
    cast r96 into r97 as u64;
    gt r19.lp_supply 0u64 into r98;
    ternary r98 r97 0u64 into r99;
    sub r52.fee r99 into r100;
    gt r99 0u64 into r101;
    branch.eq r101 false to end_then_0_2;
    get.or_use market_fee_pool[r0] 0u64 into r102;
    add r102 r99 into r103;
    set r103 into market_fee_pool[r0];
    gt r19.lp_supply 0u64 into r104;
    and r104 r101 into r105;
    branch.eq r105 false to end_then_1_4;
    get.or_use lp_fee_index[r0] 0u128 into r106;
    cast r99 into r107 as u128;
    mul r107 1000000000000u128 into r108;
    cast r19.lp_supply into r109 as u128;
