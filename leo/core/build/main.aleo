import veilmarkets_factory_v12.aleo;
program veilmarkets_core_v12.aleo;

record BetPosition:
    owner as address.private;
    position_id as field.private;
    market_id as field.private;
    outcome as u8.private;
    shares as u64.private;
    collateral_in as u64.private;
    nonce as group.private;

record WinningsClaim:
    owner as address.private;
    market_id as field.private;
    payout_amount as u64.private;
    nullifier as field.private;
    nonce as group.private;

struct MarketInfo:
    creator as address;
    title_hash as field;
    category as u8;
    market_type as u8;
    outcome_count as u8;
    close_time as u64;
    resolution_time as u64;
    is_resolved as boolean;
    winning_outcome as u8;
    resolved_by_oracle as boolean;
    token_id as address;

struct PoolState:
    trader_count as u64;
    lp_count as u64;
    locked as boolean;
    total_collateral as u64;
    lp_collateral as u64;
    lp_supply as u64;
    cumulative_volume as u64;

struct PositionState:
    holder_commitment as field;
    market_id as field;
    outcome as u8;
    shares as u64;
    collateral_in as u64;
    token_id as address;
    is_closed as boolean;

struct PayoutClaim:
    amount as u64;
    token_id as address;

struct BuyQuoteComputation:
    fee as u64;
    net_collateral_in as u64;
    shares_out as u64;
    price_micro as u64;

struct SellQuoteComputation:
    fee as u64;
    gross_payout as u64;
    net_payout as u64;

mapping markets:
    key as field.public;
    value as MarketInfo.public;

mapping pools:
    key as field.public;
    value as PoolState.public;

mapping outcome_token_qty:
    key as field.public;
    value as u64.public;

mapping outcome_token_supply:
    key as field.public;
    value as u64.public;

mapping positions:
    key as field.public;
    value as PositionState.public;

mapping lp_balances:
    key as field.public;
    value as u64.public;

mapping market_fee_pool:
    key as field.public;
    value as u64.public;

mapping market_winner_payout_pool:
    key as field.public;
    value as u64.public;

mapping market_lp_return_pool:
    key as field.public;
    value as u64.public;

mapping spent_nullifiers:
    key as field.public;
    value as boolean.public;

mapping spent_auth_ids:
    key as field.public;
    value as boolean.public;

mapping pending_payouts:
    key as field.public;
    value as PayoutClaim.public;

mapping protocol_u8:
    key as u8.public;
    value as u8.public;

mapping protocol_u64:
    key as u8.public;
    value as u64.public;

mapping protocol_fees:
    key as address.public;
    value as u64.public;

function create_market:
    input r0 as field.public;
    input r1 as u8.public;
    input r2 as u8.public;
    input r3 as u8.public;
    input r4 as u64.public;
    input r5 as u64.public;
    input r6 as address.public;
    cast self.caller into r7 as field;
    add r0 r7 into r8;
    hash.bhp256 r8 into r9 as field;
    call veilmarkets_factory_v12.aleo/verify_is_registered 1u8 r6 into r10;
    async create_market r10 r9 self.caller r0 r1 r2 r3 r4 r5 r6 into r11;
    output r11 as veilmarkets_core_v12.aleo/create_market.future;

finalize create_market:
    input r0 as veilmarkets_factory_v12.aleo/verify_is_registered.future;
    input r1 as field.public;
    input r2 as address.public;
    input r3 as field.public;
    input r4 as u8.public;
    input r5 as u8.public;
    input r6 as u8.public;
    input r7 as u64.public;
    input r8 as u64.public;
    input r9 as address.public;
    await r0;
    get.or_use protocol_u8[1u8] 0u8 into r10;
    is.eq r10 0u8 into r11;
    assert.eq r11 true;
    contains markets[r1] into r12;
    not r12 into r13;
    assert.eq r13 true;
    lte r4 6u8 into r14;
    assert.eq r14 true;
    lte r5 1u8 into r15;
    assert.eq r15 true;
    get.or_use protocol_u8[0u8] 8u8 into r16;
    gte r6 2u8 into r17;
    assert.eq r17 true;
    lte r6 r16 into r18;
    assert.eq r18 true;
    is.eq r5 0u8 into r19;
    branch.eq r19 false to end_then_0_0;
    assert.eq r6 2u8;
    branch.eq true true to end_otherwise_0_1;
    position end_then_0_0;
    position end_otherwise_0_1;
    cast block.timestamp into r20 as u64;
    gt r7 r20 into r21;
    assert.eq r21 true;
    gte r8 r7 into r22;
    assert.eq r22 true;
    cast r2 r3 r4 r5 r6 r7 r8 false 254u8 false r9 into r23 as MarketInfo;
    cast 0u64 0u64 false 0u64 0u64 0u64 0u64 into r24 as PoolState;
    set r23 into markets[r1];
    set r24 into pools[r1];

function buy_shares:
    input r0 as field.private;
    input r1 as u8.private;
    input r2 as u64.private;
    input r3 as u64.private;
    input r4 as u64.private;
    input r5 as field.private;
    input r6 as field.private;
    gt r3 0u64 into r7;
    assert.eq r7 true;
    gt r4 0u64 into r8;
    assert.eq r8 true;
    gte r4 r3 into r9;
    assert.eq r9 true;
    hash.bhp256 r5 into r10 as group;
    cast self.signer r5 r0 r1 r4 r2 r10 into r11 as BetPosition.record;
    async buy_shares r0 r1 r2 r3 r4 r5 r6 self.caller into r12;
    output r11 as BetPosition.record;
    output r12 as veilmarkets_core_v12.aleo/buy_shares.future;

finalize buy_shares:
    input r0 as field.public;
    input r1 as u8.public;
    input r2 as u64.public;
    input r3 as u64.public;
    input r4 as u64.public;
    input r5 as field.public;
    input r6 as field.public;
    input r7 as address.public;
    get.or_use protocol_u8[1u8] 0u8 into r8;
    is.eq r8 0u8 into r9;
    assert.eq r9 true;
    get markets[r0] into r10;
    assert.eq r10.token_id r7;
    not r10.is_resolved into r11;
    assert.eq r11 true;
    cast block.timestamp into r12 as u64;
    lt r12 r10.close_time into r13;
    assert.eq r13 true;
    lt r1 r10.outcome_count into r14;
    assert.eq r14 true;
    get.or_use protocol_u64[2u8] 1000000u64 into r15;
    gte r2 r15 into r16;
    assert.eq r16 true;
    get pools[r0] into r17;
    not r17.locked into r18;
    assert.eq r18 true;
    is.eq r17.lp_supply 0u64 into r19;
    branch.eq r19 false to end_then_0_2;
    get.or_use protocol_u64[3u8] 10000000u64 into r20;
    gte r17.lp_collateral r20 into r21;
    assert.eq r21 true;
    branch.eq true true to end_otherwise_0_3;
    position end_then_0_2;
    position end_otherwise_0_3;
    get.or_use protocol_u64[6u8] 100000000000u64 into r22;
    add r17.total_collateral r2 into r23;
    lte r23 r22 into r24;
    assert.eq r24 true;
    cast r1 into r25 as field;
    add r0 r25 into r26;
    hash.bhp256 r26 into r27 as field;
    get.or_use outcome_token_qty[r27] 0u64 into r28;
    gt r28 0u64 into r29;
    assert.eq r29 true;
    cast 0u8 into r30 as field;
    add r0 r30 into r31;
    hash.bhp256 r31 into r32 as field;
    cast 1u8 into r33 as field;
    add r0 r33 into r34;
    hash.bhp256 r34 into r35 as field;
    cast 2u8 into r36 as field;
    add r0 r36 into r37;
    hash.bhp256 r37 into r38 as field;
    cast 3u8 into r39 as field;
    add r0 r39 into r40;
    hash.bhp256 r40 into r41 as field;
    cast 4u8 into r42 as field;
    add r0 r42 into r43;
    hash.bhp256 r43 into r44 as field;
    cast 5u8 into r45 as field;
    add r0 r45 into r46;
    hash.bhp256 r46 into r47 as field;
    cast 6u8 into r48 as field;
    add r0 r48 into r49;
    hash.bhp256 r49 into r50 as field;
    cast 7u8 into r51 as field;
    add r0 r51 into r52;
    hash.bhp256 r52 into r53 as field;
    gt r10.outcome_count 0u8 into r54;
    is.neq r1 0u8 into r55;
    and r54 r55 into r56;
    get.or_use outcome_token_qty[r32] 0u64 into r57;
    ternary r56 r57 0u64 into r58;
    gt r10.outcome_count 1u8 into r59;
    is.neq r1 1u8 into r60;
    and r59 r60 into r61;
    get.or_use outcome_token_qty[r35] 0u64 into r62;
    ternary r61 r62 0u64 into r63;
    gt r10.outcome_count 2u8 into r64;
    is.neq r1 2u8 into r65;
    and r64 r65 into r66;
    get.or_use outcome_token_qty[r38] 0u64 into r67;
    ternary r66 r67 0u64 into r68;
    gt r10.outcome_count 3u8 into r69;
    is.neq r1 3u8 into r70;
    and r69 r70 into r71;
    get.or_use outcome_token_qty[r41] 0u64 into r72;
    ternary r71 r72 0u64 into r73;
    gt r10.outcome_count 4u8 into r74;
    is.neq r1 4u8 into r75;
    and r74 r75 into r76;
    get.or_use outcome_token_qty[r44] 0u64 into r77;
    ternary r76 r77 0u64 into r78;
    gt r10.outcome_count 5u8 into r79;
    is.neq r1 5u8 into r80;
    and r79 r80 into r81;
    get.or_use outcome_token_qty[r47] 0u64 into r82;
    ternary r81 r82 0u64 into r83;
    gt r10.outcome_count 6u8 into r84;
    is.neq r1 6u8 into r85;
    and r84 r85 into r86;
    get.or_use outcome_token_qty[r50] 0u64 into r87;
    ternary r86 r87 0u64 into r88;
    gt r10.outcome_count 7u8 into r89;
    is.neq r1 7u8 into r90;
    and r89 r90 into r91;
    get.or_use outcome_token_qty[r53] 0u64 into r92;
    ternary r91 r92 0u64 into r93;
    add r58 r63 into r94;
    add r94 r68 into r95;
    add r95 r73 into r96;
    add r96 r78 into r97;
    add r97 r83 into r98;
    add r98 r88 into r99;
    add r99 r93 into r100;
    gt r100 0u64 into r101;
    assert.eq r101 true;
    get.or_use protocol_u64[1u8] 100u64 into r102;
    lte r102 10000u64 into r103;
    assert.eq r103 true;
    assert.eq true true;
    cast r2 into r104 as u128;
    cast r102 into r105 as u128;
    mul r104 r105 into r106;
    cast 10000u64 into r107 as u128;
    div r106 r107 into r108;
    cast r108 into r109 as u64;
    sub r2 r109 into r110;
    gt r110 0u64 into r111;
    assert.eq r111 true;
    assert.eq r101 true;
    add r100 r110 into r112;
    gt r112 0u64 into r113;
    assert.eq r113 true;
    cast r28 into r114 as u128;
    cast r110 into r115 as u128;
    mul r114 r115 into r116;
    cast r112 into r117 as u128;
    div r116 r117 into r118;
    cast r118 into r119 as u64;
    gt r119 0u64 into r120;
    assert.eq r120 true;
    assert.eq r111 true;
    cast r119 into r121 as u128;
    cast 1000000u64 into r122 as u128;
    mul r121 r122 into r123;
    cast r110 into r124 as u128;
    div r123 r124 into r125;
    cast r125 into r126 as u64;
    cast r109 r110 r119 r126 into r127 as BuyQuoteComputation;
    gt r127.shares_out 0u64 into r128;
    assert.eq r128 true;
    gte r127.shares_out r3 into r129;
    assert.eq r129 true;
    assert.eq r127.shares_out r4;
    lt r127.shares_out r28 into r130;
    assert.eq r130 true;
    hash.bhp256 r5 into r131 as field;
    assert.eq r6 r131;
    contains positions[r5] into r132;
    not r132 into r133;
    assert.eq r133 true;
    sub r28 r127.shares_out into r134;
    set r134 into outcome_token_qty[r27];
    add r17.trader_count 1u64 into r135;
    add r17.total_collateral r127.net_collateral_in into r136;
    add r17.cumulative_volume r2 into r137;
    cast r135 r17.lp_count false r136 r17.lp_collateral r17.lp_supply r137 into r138 as PoolState;
    set r138 into pools[r0];
    get.or_use protocol_u64[5u8] 8000u64 into r139;
    assert.eq true true;
    cast r127.fee into r140 as u128;
    cast r139 into r141 as u128;
    mul r140 r141 into r142;
    cast 10000u64 into r143 as u128;
    div r142 r143 into r144;
    cast r144 into r145 as u64;
    sub r127.fee r145 into r146;
    get.or_use market_fee_pool[r0] 0u64 into r147;
    add r147 r145 into r148;
    set r148 into market_fee_pool[r0];
    get.or_use protocol_fees[r7] 0u64 into r149;
    add r149 r146 into r150;
    set r150 into protocol_fees[r7];
    cast r6 r0 r1 r127.shares_out r2 r10.token_id false into r151 as PositionState;
    set r151 into positions[r5];

function fund_pool:
    input r0 as field.public;
    input r1 as u64.public;
    input r2 as field.public;
    async fund_pool r0 r1 r2 self.caller into r3;
    output r3 as veilmarkets_core_v12.aleo/fund_pool.future;

finalize fund_pool:
    input r0 as field.public;
    input r1 as u64.public;
    input r2 as field.public;
    input r3 as address.public;
    get.or_use protocol_u8[1u8] 0u8 into r4;
    is.eq r4 0u8 into r5;
    assert.eq r5 true;
    get markets[r0] into r6;
    assert.eq r6.token_id r3;
    not r6.is_resolved into r7;
    assert.eq r7 true;
    cast block.timestamp into r8 as u64;
    lt r8 r6.close_time into r9;
    assert.eq r9 true;
    get.or_use protocol_u64[3u8] 10000000u64 into r10;
    gte r1 r10 into r11;
    assert.eq r11 true;
    get pools[r0] into r12;
    not r12.locked into r13;
    assert.eq r13 true;
    get.or_use protocol_u64[6u8] 100000000000u64 into r14;
    add r12.total_collateral r1 into r15;
    lte r15 r14 into r16;
    assert.eq r16 true;
    cast r6.outcome_count into r17 as u64;
    div r1 r17 into r18;
    gt r18 0u64 into r19;
    assert.eq r19 true;
    gt r6.outcome_count 0u8 into r20;
    branch.eq r20 false to end_then_0_4;
    cast 0u8 into r21 as field;
    add r0 r21 into r22;
    hash.bhp256 r22 into r23 as field;
    get.or_use outcome_token_qty[r23] 0u64 into r24;
    add r24 r18 into r25;
    set r25 into outcome_token_qty[r23];
    get.or_use outcome_token_supply[r23] 0u64 into r26;
    add r26 r18 into r27;
    set r27 into outcome_token_supply[r23];
    branch.eq true true to end_otherwise_0_5;
    position end_then_0_4;
    position end_otherwise_0_5;
    gt r6.outcome_count 1u8 into r28;
    branch.eq r28 false to end_then_0_6;
    cast 1u8 into r29 as field;
    add r0 r29 into r30;
    hash.bhp256 r30 into r31 as field;
    get.or_use outcome_token_qty[r31] 0u64 into r32;
    add r32 r18 into r33;
    set r33 into outcome_token_qty[r31];
    get.or_use outcome_token_supply[r31] 0u64 into r34;
    add r34 r18 into r35;
    set r35 into outcome_token_supply[r31];
    branch.eq true true to end_otherwise_0_7;
    position end_then_0_6;
    position end_otherwise_0_7;
    gt r6.outcome_count 2u8 into r36;
    branch.eq r36 false to end_then_0_8;
    cast 2u8 into r37 as field;
    add r0 r37 into r38;
    hash.bhp256 r38 into r39 as field;
    get.or_use outcome_token_qty[r39] 0u64 into r40;
    add r40 r18 into r41;
    set r41 into outcome_token_qty[r39];
    get.or_use outcome_token_supply[r39] 0u64 into r42;
    add r42 r18 into r43;
    set r43 into outcome_token_supply[r39];
    branch.eq true true to end_otherwise_0_9;
    position end_then_0_8;
    position end_otherwise_0_9;
    gt r6.outcome_count 3u8 into r44;
    branch.eq r44 false to end_then_0_10;
    cast 3u8 into r45 as field;
    add r0 r45 into r46;
    hash.bhp256 r46 into r47 as field;
    get.or_use outcome_token_qty[r47] 0u64 into r48;
    add r48 r18 into r49;
    set r49 into outcome_token_qty[r47];
    get.or_use outcome_token_supply[r47] 0u64 into r50;
    add r50 r18 into r51;
    set r51 into outcome_token_supply[r47];
    branch.eq true true to end_otherwise_0_11;
    position end_then_0_10;
    position end_otherwise_0_11;
    gt r6.outcome_count 4u8 into r52;
    branch.eq r52 false to end_then_0_12;
    cast 4u8 into r53 as field;
    add r0 r53 into r54;
    hash.bhp256 r54 into r55 as field;
    get.or_use outcome_token_qty[r55] 0u64 into r56;
    add r56 r18 into r57;
    set r57 into outcome_token_qty[r55];
    get.or_use outcome_token_supply[r55] 0u64 into r58;
    add r58 r18 into r59;
    set r59 into outcome_token_supply[r55];
    branch.eq true true to end_otherwise_0_13;
    position end_then_0_12;
    position end_otherwise_0_13;
    gt r6.outcome_count 5u8 into r60;
    branch.eq r60 false to end_then_0_14;
    cast 5u8 into r61 as field;
    add r0 r61 into r62;
    hash.bhp256 r62 into r63 as field;
    get.or_use outcome_token_qty[r63] 0u64 into r64;
    add r64 r18 into r65;
    set r65 into outcome_token_qty[r63];
    get.or_use outcome_token_supply[r63] 0u64 into r66;
    add r66 r18 into r67;
    set r67 into outcome_token_supply[r63];
    branch.eq true true to end_otherwise_0_15;
    position end_then_0_14;
    position end_otherwise_0_15;
    gt r6.outcome_count 6u8 into r68;
    branch.eq r68 false to end_then_0_16;
    cast 6u8 into r69 as field;
    add r0 r69 into r70;
    hash.bhp256 r70 into r71 as field;
    get.or_use outcome_token_qty[r71] 0u64 into r72;
    add r72 r18 into r73;
    set r73 into outcome_token_qty[r71];
    get.or_use outcome_token_supply[r71] 0u64 into r74;
    add r74 r18 into r75;
    set r75 into outcome_token_supply[r71];
    branch.eq true true to end_otherwise_0_17;
    position end_then_0_16;
    position end_otherwise_0_17;
    gt r6.outcome_count 7u8 into r76;
    branch.eq r76 false to end_then_0_18;
    cast 7u8 into r77 as field;
    add r0 r77 into r78;
    hash.bhp256 r78 into r79 as field;
    get.or_use outcome_token_qty[r79] 0u64 into r80;
    add r80 r18 into r81;
    set r81 into outcome_token_qty[r79];
    get.or_use outcome_token_supply[r79] 0u64 into r82;
    add r82 r18 into r83;
    set r83 into outcome_token_supply[r79];
    branch.eq true true to end_otherwise_0_19;
    position end_then_0_18;
    position end_otherwise_0_19;
    add r12.lp_count 1u64 into r84;
    add r12.total_collateral r1 into r85;
    add r12.lp_collateral r1 into r86;
    add r12.lp_supply r1 into r87;
    cast r12.trader_count r84 false r85 r86 r87 r12.cumulative_volume into r88 as PoolState;
    set r88 into pools[r0];
    add r0 r2 into r89;
    hash.bhp256 r89 into r90 as field;
    get.or_use lp_balances[r90] 0u64 into r91;
    add r91 r1 into r92;
    set r92 into lp_balances[r90];

function sell_shares:
    input r0 as BetPosition.record;
    input r1 as u64.public;
    input r2 as u64.public;
    input r3 as field.private;
    gt r1 0u64 into r4;
    assert.eq r4 true;
    gte r0.shares r1 into r5;
    assert.eq r5 true;
    gt r0.shares 0u64 into r6;
    assert.eq r6 true;
    cast r0.collateral_in into r7 as u128;
    cast r1 into r8 as u128;
    mul r7 r8 into r9;
    cast r0.shares into r10 as u128;
    div r9 r10 into r11;
    cast r11 into r12 as u64;
    sub r0.shares r1 into r13;
    sub r0.collateral_in r12 into r14;
    add r0.position_id r3 into r15;
    hash.bhp256 r15 into r16 as group;
    cast r0.owner r0.position_id r0.market_id r0.outcome r13 r14 r16 into r17 as BetPosition.record;
    cast r1 into r18 as field;
    add r0.position_id r18 into r19;
    add r19 r3 into r20;
    hash.bhp256 r20 into r21 as field;
    hash.bhp256 r21 into r22 as group;
    cast r0.owner r0.market_id 0u64 r21 r22 into r23 as WinningsClaim.record;
    hash.bhp256 r0.position_id into r24 as field;
    async sell_shares r0.position_id r0.market_id r0.outcome r0.shares r0.collateral_in r1 r2 r13 r14 r21 r24 into r25;
    output r17 as BetPosition.record;
    output r23 as WinningsClaim.record;
    output r25 as veilmarkets_core_v12.aleo/sell_shares.future;

finalize sell_shares:
    input r0 as field.public;
    input r1 as field.public;
    input r2 as u8.public;
    input r3 as u64.public;
    input r4 as u64.public;
    input r5 as u64.public;
    input r6 as u64.public;
    input r7 as u64.public;
    input r8 as u64.public;
    input r9 as field.public;
    input r10 as field.public;
    get.or_use protocol_u8[1u8] 0u8 into r11;
    is.eq r11 0u8 into r12;
    assert.eq r12 true;
    get.or_use spent_nullifiers[r9] false into r13;
    not r13 into r14;
    assert.eq r14 true;
    set true into spent_nullifiers[r9];
    get positions[r0] into r15;
    not r15.is_closed into r16;
    assert.eq r16 true;
    assert.eq r15.holder_commitment r10;
    assert.eq r15.market_id r1;
    assert.eq r15.outcome r2;
    assert.eq r15.shares r3;
    assert.eq r15.collateral_in r4;
    gte r15.shares r5 into r17;
    assert.eq r17 true;
