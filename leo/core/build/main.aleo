    div r19.total_collateral r41 into r42;
    add r42 r26 into r43;
    add r43 r24 into r44;
    gt r44 0u64 into r45;
    assert.eq r45 true;
    cast r36 into r46 as u128;
    cast r40 into r47 as u128;
    cast r44 into r48 as u128;
    mul r46 r47 into r49;
    div r49 r48 into r50;
    cast r50 into r51 as u64;
    cast r35 r36 r51 into r52 as BuyQuoteComputation;
    gt r52.shares_out 0u64 into r53;
    assert.eq r53 true;
    gte r52.shares_out r3 into r54;
    assert.eq r54 true;
    assert.eq r4 r52.net_collateral_in;
    assert.eq r5 r52.shares_out;
