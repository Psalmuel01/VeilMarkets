import veilmarkets_factory_v10.aleo;
program veilmarkets_core_v10.aleo;

record BetPosition:
    owner as address.private;
    position_id as field.private;
    market_id as field.private;
    outcome as u8.private;
    amount as u64.private;
    escrow_id as field.private;
    shares as u64.private;
    collateral_in as u64.private;
    nonce as group.private;

record WinningsClaim:
    owner as address.private;
    market_id as field.private;
    payout_amount as u64.private;
    nullifier as field.private;
    nonce as group.private;

struct MarketInfo:
    creator as address;
    title_hash as field;
    category as u8;
    market_type as u8;
    outcome_count as u8;
    close_time as u64;
    resolution_time as u64;
    is_resolved as boolean;
    winning_outcome as u8;
    resolved_by_oracle as boolean;
    token_id as address;

struct PoolState:
    total_outcome_0 as u64;
    total_outcome_1 as u64;
    total_outcome_2 as u64;
    total_outcome_3 as u64;
    total_outcome_4 as u64;
    total_outcome_5 as u64;
    total_outcome_6 as u64;
    total_outcome_7 as u64;
    trader_count as u64;
    lp_count as u64;
    locked as boolean;
    trading_collateral as u64;
    lp_collateral as u64;
    total_collateral as u64;
    total_shares as u64;
    lp_supply as u64;
    cumulative_volume as u64;

struct PositionState:
    holder_commitment as field;
    market_id as field;
    outcome as u8;
    shares as u64;
    collateral_in as u64;
    token_id as address;
    is_closed as boolean;

struct PayoutClaim:
    amount as u64;
    token_id as address;

struct BuyQuoteComputation:
    fee as u64;
    net_collateral_in as u64;
    shares_out as u64;

struct SellQuoteComputation:
    fee as u64;
    gross_payout as u64;
    net_payout as u64;

mapping markets:
    key as field.public;
    value as MarketInfo.public;

mapping pools:
    key as field.public;
    value as PoolState.public;

mapping outcome_exposure:
    key as field.public;
    value as u64.public;

mapping outcome_share_supply:
    key as field.public;
    value as u64.public;

mapping positions:
    key as field.public;
    value as PositionState.public;

mapping lp_balances:
    key as field.public;
    value as u64.public;

mapping market_fee_pool:
    key as field.public;
    value as u64.public;

mapping lp_fee_index:
    key as field.public;
    value as u128.public;

mapping lp_fee_checkpoint:
    key as field.public;
    value as u128.public;

mapping lp_pending_fees:
    key as field.public;
    value as u64.public;

mapping market_winner_supply_snapshot:
    key as field.public;
    value as u64.public;

mapping market_winner_payout_remaining:
    key as field.public;
    value as u64.public;

mapping market_lp_trading_surplus:
    key as field.public;
    value as u64.public;

mapping spent_nullifiers:
    key as field.public;
    value as boolean.public;

mapping pending_payouts:
    key as field.public;
    value as PayoutClaim.public;

mapping protocol_u8:
    key as u8.public;
    value as u8.public;

mapping protocol_u64:
    key as u8.public;
    value as u64.public;

mapping protocol_fees:
    key as address.public;
    value as u64.public;

function create_market:
    input r0 as field.public;
    input r1 as u8.public;
    input r2 as u8.public;
    input r3 as u8.public;
    input r4 as u64.public;
    input r5 as u64.public;
    input r6 as address.public;
    call veilmarkets_factory_v10.aleo/verify_is_registered 1u8 r6 into r7;
    cast self.caller into r8 as field;
    add r0 r8 into r9;
    hash.bhp256 r9 into r10 as field;
    async create_market r10 self.caller r0 r1 r2 r3 r4 r5 r6 r7 into r11;
    output r11 as veilmarkets_core_v10.aleo/create_market.future;

finalize create_market:
    input r0 as field.public;
    input r1 as address.public;
    input r2 as field.public;
    input r3 as u8.public;
    input r4 as u8.public;
    input r5 as u8.public;
    input r6 as u64.public;
    input r7 as u64.public;
    input r8 as address.public;
    input r9 as veilmarkets_factory_v10.aleo/verify_is_registered.future;
    await r9;
    get.or_use protocol_u8[1u8] 0u8 into r10;
    is.eq r10 0u8 into r11;
    assert.eq r11 true;
    contains markets[r0] into r12;
    not r12 into r13;
    assert.eq r13 true;
    lte r3 6u8 into r14;
    assert.eq r14 true;
    lte r4 1u8 into r15;
    assert.eq r15 true;
    get.or_use protocol_u8[0u8] 32u8 into r16;
    gte r16 2u8 into r17;
    assert.eq r17 true;
    lte r16 32u8 into r18;
    assert.eq r18 true;
    gte r5 2u8 into r19;
    assert.eq r19 true;
    lte r5 r16 into r20;
    assert.eq r20 true;
    is.eq r4 0u8 into r21;
    branch.eq r21 false to end_then_0_0;
    assert.eq r5 2u8;
    branch.eq true true to end_otherwise_0_1;
    position end_then_0_0;
    position end_otherwise_0_1;
    cast block.timestamp into r22 as u64;
    gt r6 r22 into r23;
    assert.eq r23 true;
    gt r7 r6 into r24;
    assert.eq r24 true;
    cast r1 r2 r3 r4 r5 r6 r7 false 254u8 false r8 into r25 as MarketInfo;
    cast 0u64 0u64 0u64 0u64 0u64 0u64 0u64 0u64 0u64 0u64 false 0u64 0u64 0u64 0u64 0u64 0u64 into r26 as PoolState;
    set r25 into markets[r0];
    set r26 into pools[r0];

