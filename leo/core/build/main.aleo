    div r104 r105 into r106;
    cast r106 into r107 as u64;
    cast r90 r91 r100 r107 into r108 as BuyQuoteComputation;
    gt r108.shares_out 0u64 into r109;
    assert.eq r109 true;
    gte r108.shares_out r3 into r110;
