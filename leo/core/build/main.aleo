    set r66 into outcome_exposure[r23];
    set r67 into outcome_share_supply[r23];
    is.eq r1 0u8 into r69;
    ternary r69 r66 r19.total_outcome_0 into r70;
    is.eq r1 1u8 into r71;
    ternary r71 r66 r19.total_outcome_1 into r72;
    is.eq r1 2u8 into r73;
    ternary r73 r66 r19.total_outcome_2 into r74;
    is.eq r1 3u8 into r75;
    ternary r75 r66 r19.total_outcome_3 into r76;
    is.eq r1 4u8 into r77;
    ternary r77 r66 r19.total_outcome_4 into r78;
    is.eq r1 5u8 into r79;
    ternary r79 r66 r19.total_outcome_5 into r80;
    is.eq r1 6u8 into r81;
    ternary r81 r66 r19.total_outcome_6 into r82;
    is.eq r1 7u8 into r83;
    ternary r83 r66 r19.total_outcome_7 into r84;
