    assert.eq r112 true;
    assert.eq r102 true;
    add r101 r111 into r113;
    gt r113 0u64 into r114;
    assert.eq r114 true;
    cast r29 into r115 as u128;
    cast r111 into r116 as u128;
    mul r115 r116 into r117;
    cast r113 into r118 as u128;
    div r117 r118 into r119;
    cast r119 into r120 as u64;
    gt r120 0u64 into r121;
    assert.eq r121 true;
    assert.eq r112 true;
    cast r120 into r122 as u128;
    cast 1000000u64 into r123 as u128;
    mul r122 r123 into r124;
