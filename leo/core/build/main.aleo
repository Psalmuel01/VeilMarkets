    gt r4 0u64 into r9;
    assert.eq r9 true;
    gt r5 0u64 into r10;
    assert.eq r10 true;
    hash.bhp256 r6 into r11 as group;
    cast self.signer r6 r0 r1 r4 r6 r5 r4 r11 into r12 as BetPosition.record;
    async buy_shares r0 r1 r2 r3 r4 r5 r6 r7 self.signer self.caller into r13;
    output r12 as BetPosition.record;
    output r13 as veilmarkets_core_v10.aleo/buy_shares.future;

