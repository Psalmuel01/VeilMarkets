    input r6 as field.public;
    gt r3 0u64 into r7;
    assert.eq r7 true;
    gt r4 0u64 into r8;
    assert.eq r8 true;
    gte r4 r3 into r9;
    assert.eq r9 true;
    hash.bhp256 r5 into r10 as group;
    cast self.signer r5 r0 r1 r4 r2 r10 into r11 as BetPosition.record;
    async buy_shares r0 r1 r2 r3 r4 r5 r6 self.signer self.caller into r12;
    output r11 as BetPosition.record;
    output r12 as veilmarkets_core_build_v11.aleo/buy_shares.future;

finalize buy_shares:
