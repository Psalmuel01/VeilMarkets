    assert.eq r6 r134;
    contains positions[r5] into r135;
    not r135 into r136;
    assert.eq r136 true;
    sub r29 r128.shares_out into r137;
    set r137 into outcome_token_qty[r28];
    add r18.trader_count 1u64 into r138;
    add r18.total_collateral r128.net_collateral_in into r139;
    add r18.cumulative_volume r2 into r140;
    cast r138 r18.lp_count false r139 r18.lp_collateral r18.lp_supply r140 into r141 as PoolState;
    set r141 into pools[r0];
