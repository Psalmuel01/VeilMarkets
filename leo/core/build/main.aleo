    ternary r29 r18 0u64 into r30;
    add r12.total_outcome_2 r30 into r31;
    gt r6.outcome_count 3u8 into r32;
    ternary r32 r18 0u64 into r33;
    add r12.total_outcome_3 r33 into r34;
