    branch.eq true true to end_otherwise_0_3;
    position end_then_0_2;
    position end_otherwise_0_3;
    get.or_use protocol_u64[6u8] 100000000000u64 into r23;
    add r18.total_collateral r2 into r24;
    lte r24 r23 into r25;
    assert.eq r25 true;
    cast r1 into r26 as field;
