import veilmarkets_factory_v9.aleo;
import veilmarkets_v9.aleo;
program test_veilmarkets.aleo;

closure is_valid_market_shape:
    input r0 as u8;
    input r1 as u8;
    gt r0 1u8 into r2;
    is.eq r0 0u8 into r3;
    is.eq r1 2u8 into r4;
    lt r1 2u8 into r5;
    lte r1 32u8 into r6;
    ternary r5 false r6 into r7;
    ternary r3 r4 r7 into r8;
    ternary r2 false r8 into r9;
    output r9 as boolean;

function validates_market_shape_rules:
    call is_valid_market_shape 0u8 2u8 into r0;
    assert.eq r0 true;
    call is_valid_market_shape 1u8 2u8 into r1;
    assert.eq r1 true;
    call is_valid_market_shape 1u8 3u8 into r2;
    assert.eq r2 true;
    call is_valid_market_shape 1u8 4u8 into r3;
    assert.eq r3 true;
    call is_valid_market_shape 1u8 32u8 into r4;
    assert.eq r4 true;
    call is_valid_market_shape 0u8 3u8 into r5;
    assert.eq r5 false;
    call is_valid_market_shape 1u8 1u8 into r6;
    assert.eq r6 false;
    call is_valid_market_shape 1u8 33u8 into r7;
    assert.eq r7 false;
    call is_valid_market_shape 2u8 2u8 into r8;
    assert.eq r8 false;

function quote_scales_outcome_counts:
    cast 2u8 into r0 as u64;
    mul 10000000u64 r0 into r1;
    add 50000000u64 r1 into r2;
    div 50000000u64 r0 into r3;
    add r3 10000000u64 into r4;
    add r4 4000000u64 into r5;
    gt r5 0u64 into r6;
    assert.eq r6 true;
    cast 9000000u64 into r7 as u128;
    cast r2 into r8 as u128;
    cast r5 into r9 as u128;
    mul r7 r8 into r10;
    div r10 r9 into r11;
    cast r11 into r12 as u64;
    is.eq r12 0u64 into r13;
    ternary r13 1u64 r12 into r14;
    cast 3u8 into r15 as u64;
    mul 10000000u64 r15 into r16;
    add 50000000u64 r16 into r17;
    div 50000000u64 r15 into r18;
    add r18 10000000u64 into r19;
    add r19 4000000u64 into r20;
    gt r20 0u64 into r21;
    assert.eq r21 true;
    cast 9000000u64 into r22 as u128;
    cast r17 into r23 as u128;
    cast r20 into r24 as u128;
    mul r22 r23 into r25;
    div r25 r24 into r26;
    cast r26 into r27 as u64;
    is.eq r27 0u64 into r28;
    ternary r28 1u64 r27 into r29;
    cast 8u8 into r30 as u64;
    mul 10000000u64 r30 into r31;
    add 50000000u64 r31 into r32;
    div 50000000u64 r30 into r33;
    add r33 10000000u64 into r34;
    add r34 4000000u64 into r35;
    gt r35 0u64 into r36;
    assert.eq r36 true;
    cast 9000000u64 into r37 as u128;
    cast r32 into r38 as u128;
    cast r35 into r39 as u128;
    mul r37 r38 into r40;
    div r40 r39 into r41;
    cast r41 into r42 as u64;
    is.eq r42 0u64 into r43;
    ternary r43 1u64 r42 into r44;
    cast 16u8 into r45 as u64;
    mul 10000000u64 r45 into r46;
    add 50000000u64 r46 into r47;
    div 50000000u64 r45 into r48;
    add r48 10000000u64 into r49;
    add r49 4000000u64 into r50;
    gt r50 0u64 into r51;
    assert.eq r51 true;
    cast 9000000u64 into r52 as u128;
    cast r47 into r53 as u128;
    cast r50 into r54 as u128;
    mul r52 r53 into r55;
    div r55 r54 into r56;
    cast r56 into r57 as u64;
    is.eq r57 0u64 into r58;
    ternary r58 1u64 r57 into r59;
    cast 32u8 into r60 as u64;
    mul 10000000u64 r60 into r61;
    add 50000000u64 r61 into r62;
    div 50000000u64 r60 into r63;
    add r63 10000000u64 into r64;
    add r64 4000000u64 into r65;
    gt r65 0u64 into r66;
    assert.eq r66 true;
    cast 9000000u64 into r67 as u128;
    cast r62 into r68 as u128;
    cast r65 into r69 as u128;
    mul r67 r68 into r70;
    div r70 r69 into r71;
    cast r71 into r72 as u64;
    is.eq r72 0u64 into r73;
    ternary r73 1u64 r72 into r74;
    gt r14 0u64 into r75;
    assert.eq r75 true;
    gt r29 0u64 into r76;
    assert.eq r76 true;
    gt r44 0u64 into r77;
    assert.eq r77 true;
    gt r59 0u64 into r78;
    assert.eq r78 true;
    gt r74 0u64 into r79;
    assert.eq r79 true;
    gte r74 r14 into r80;
    assert.eq r80 true;

function claim_nullifier_changes:
    hash.bhp256 aleo1cnd2pmg8g4htpuegy8eyer9s33h0shs2yxtt8au5hl9sl566qggskfcu3n into r0 as field;
    add r0 111field into r1;
    cast 2500000u64 into r2 as field;
    add r1 r2 into r3;
    hash.bhp256 r3 into r4 as field;
    cast 2500001u64 into r5 as field;
    add r1 r5 into r6;
    hash.bhp256 r6 into r7 as field;
    add r0 112field into r8;
    cast 2500000u64 into r9 as field;
    add r8 r9 into r10;
    hash.bhp256 r10 into r11 as field;
    is.neq r4 r7 into r12;
    assert.eq r12 true;
    is.neq r4 r11 into r13;
    assert.eq r13 true;

function outcome_within_count:
    assert.eq true true;
    assert.eq false false;

function winner_redemption_proportional:
    assert.eq true true;
    cast 6000000u64 into r0 as u128;
    cast 120000000u64 into r1 as u128;
    cast 30000000u64 into r2 as u128;
    mul r0 r1 into r3;
    div r3 r2 into r4;
    cast r4 into r5 as u64;
    assert.eq r5 24000000u64;
    assert.eq 0u64 0u64;

function buy_sell_fee_conservation:
    assert.eq true true;
    cast 10000000u64 into r0 as u128;
    cast 100u64 into r1 as u128;
    cast 10000u64 into r2 as u128;
    mul r0 r1 into r3;
    div r3 r2 into r4;
    cast r4 into r5 as u64;
    sub 10000000u64 r5 into r6;
    cast 3u8 into r7 as u64;
    mul 10000000u64 r7 into r8;
    add 80000000u64 r8 into r9;
    div 80000000u64 r7 into r10;
    add r10 10000000u64 into r11;
    add r11 12000000u64 into r12;
    gt r12 0u64 into r13;
    assert.eq r13 true;
    cast r6 into r14 as u128;
    cast r9 into r15 as u128;
    cast r12 into r16 as u128;
    mul r14 r15 into r17;
    div r17 r16 into r18;
    cast r18 into r19 as u64;
    is.eq r19 0u64 into r20;
    ternary r20 1u64 r19 into r21;
    gt r21 0u64 into r22;
    assert.eq r22 true;
    add 80000000u64 r6 into r23;
    add 12000000u64 r6 into r24;
    cast 3u8 into r25 as u64;
    mul 10000000u64 r25 into r26;
    add r23 r26 into r27;
    div r23 r25 into r28;
    add r28 10000000u64 into r29;
    add r29 r24 into r30;
    gt r27 0u64 into r31;
    assert.eq r31 true;
    cast r21 into r32 as u128;
    cast r30 into r33 as u128;
    cast r27 into r34 as u128;
    mul r32 r33 into r35;
    div r35 r34 into r36;
    cast r36 into r37 as u64;
    assert.eq true true;
    cast r37 into r38 as u128;
    cast 100u64 into r39 as u128;
    cast 10000u64 into r40 as u128;
    mul r38 r39 into r41;
    div r41 r40 into r42;
    cast r42 into r43 as u64;
    sub r37 r43 into r44;
    gt r37 0u64 into r45;
    assert.eq r45 true;
    gt r44 0u64 into r46;
    assert.eq r46 true;
    lte r44 r23 into r47;
    assert.eq r47 true;
    add r5 r43 into r48;
    gt r48 0u64 into r49;
    assert.eq r49 true;

function sell_quote_scales_with_shares:
    cast 4u8 into r0 as u64;
    mul 12000000u64 r0 into r1;
    add 150000000u64 r1 into r2;
    div 150000000u64 r0 into r3;
    add r3 12000000u64 into r4;
    add r4 35000000u64 into r5;
    gt r2 0u64 into r6;
    assert.eq r6 true;
    cast 1000000u64 into r7 as u128;
    cast r5 into r8 as u128;
    cast r2 into r9 as u128;
    mul r7 r8 into r10;
    div r10 r9 into r11;
    cast r11 into r12 as u64;
    cast 4u8 into r13 as u64;
    mul 12000000u64 r13 into r14;
    add 150000000u64 r14 into r15;
    div 150000000u64 r13 into r16;
    add r16 12000000u64 into r17;
    add r17 35000000u64 into r18;
    gt r15 0u64 into r19;
    assert.eq r19 true;
    cast 3000000u64 into r20 as u128;
    cast r18 into r21 as u128;
    cast r15 into r22 as u128;
    mul r20 r21 into r23;
    div r23 r22 into r24;
    cast r24 into r25 as u64;
    gt r12 0u64 into r26;
    assert.eq r26 true;
    gt r25 r12 into r27;
    assert.eq r27 true;

constructor:
    assert.eq edition 0u16;
